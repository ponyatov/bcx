#include "cli.hpp"

%%machine hex;
%%write  data;

static int   cs  = 0;        ///< current state
static int   act = 0;        ///< ???
static char* eof = nullptr;  ///< end of file marker
static char* ts  = nullptr;  ///< token start
static char* te  = nullptr;  ///< token end
static int   top = 0;        ///< stack top
static int stack[4];         ///< call stack

static int  resn =    0;     ///< result number
static bool sign = true;     ///< +sign flag

static int hex(char* p, char* pe) {
    resn = 0; sign = true;
    eof = pe; cs = act = 0; ts = te = nullptr;
    %%write init nocs;
    %%write exec;
    if (sign) return +resn; else return -resn;
}

cell hex(char *s) { return hex(s,s+strlen(s)); }

%%{
    hex := |*
        [0-9] => { resn = resn << 4 | (ts[0] - '0'); };
        [a-f] => { resn = resn << 4 | (ts[0] - 'a' + 0x0A); };
        [A-F] => { resn = resn << 4 | (ts[0] - 'A' + 0x0A); };
        any   => { yyerror("hex"); };
    *|;

    main := |*
        '+'   => { sign =  true; };
        '-'   => { sign = false; };
        "0x"  => { fcall hex; };
        any   => { yyerror("hex"); };
    *|;
}%%
