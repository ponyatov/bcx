%include binpac.pac

analyzer BCX withcontext {
    connection: BCX_Conn;
    flow:       BCX_Flow;
};

connection BCX_Conn(bro_analyzer: BroAnalyzer) {
    upflow   = BCX_Flow(true);
    downflow = BCX_Flow(false);
};

flow BCX_Flow(is_orig: bool) {
    datagram = BCX_File withcontext(connection, this);
};

type BCX_File = record {
    header: BCX_Header;
    data:   bytestring &restofdata;
} &let {
    proc: bool = $context.flow.proc_bcx_file(this);
};

type BCX_Header = record {
    magic:   bytestring &length=4;
    max:     uint32;
    cp:      uint16;
    ip:      uint16;
    rmax:    uint16;
    dmax:    uint16;
    latest:  uint16;
} &let {
    proc: bool = $context.flow.proc_bcx_header(this);
};

refine flow BCX_Flow += {
    function proc_bcx_file(file: BCX_File): bool
        %{
        printf("BCX Binary File Dump:\n");
        printf("=====================\n");
        return true;
        %}

    function proc_bcx_header(header: BCX_Header): bool
        %{
        printf("Header:\n");
        printf("  Magic:    %.4s\n", header->magic()->data());
        printf("  Max Size: %u bytes\n", header->max());
        printf("  CP:       0x%04x\n", header->cp());
        printf("  IP:       0x%04x\n", header->ip());
        printf("  R Max:    %u\n", header->rmax());
        printf("  D Max:    %u\n", header->dmax());
        printf("  Latest:   0x%04x\n", header->latest());
        printf("\n");
        return true;
        %}
};
