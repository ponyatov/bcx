{
    "name"        : "bcx",
    "displayName" : "bcx: ByteCode eXecutor",
    "description" : "script language VM for embedded systems",
    "version"     : "0.0.1",
    "icon"        : "./logo.png",
    "publisher"   : "dponyatov",
    "license"     : "MIT",
    "homepage"    : "https://github.com/ponyatov/bcx",
    "author": {
        "name": "Dmitry Ponyatov", "email": "dponyatov@gmail.com"
    },
    "bugs": {
        "url": "https://github.com/ponyatov/bcx/issue"
    },
    "repository": {
        "type": "git", "url" : "https://github.com/ponyatov/bcx/tree/dponyatov/vscode"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages", "Debuggers"
    ],
    "keywords": [
        "bcx", "bytecode", "VM",
        "FORTH","CLI", "REPL",
        "embedded", "MCU", "STM32", "ESP32"
    ],
    "activationEvents": [
        "onLanguage:bcx",
        "onDebugResolve:bcx",
        "onDebugDynamicConfigurations:bcx",
        "workspaceContains:lib/*.ini",
        "workspaceContains:lib/*.?"
    ],
    "extensionDependencies": [
        "ms-vscode.cpptools",
        "jeff-hykin.better-cpp-syntax",
        "ms-vscode.cmake-tools",
        "daohong-emilio.yash",
        "rreverser.ragel",
        "zixuanwang.linkerscript",
        "ms-vscode.vscode-serial-monitor"
    ],
    "main": "./extension.js",
    "contributes": {
        "languages": [
            {
                "id": "bcx",
                "aliases": [
                    "bcx",
                    "ByteCode eXecutor"
                ],
                "extensions": [
                    ".bcx",
                    ".ini",
                    ".f"
                ],
                "configuration": "./languageConfiguration.json"
            }
        ],
        "grammars": [
            {
                "language": "bcx",
                "scopeName": "source.bcx",
                "path": "./tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "bcx",
                "path": "./snippets.json"
            }
        ],
        "debuggers": [
            {
                "type": "bcx",
                "label": "bcx bytecode debugger",
                "languages": ["bcx"],
                "configurationAttributes": {
                    "launch": {
                        "required": [],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Path to the DAP-enabled VM",
                                "default": "${workspaceFolder}/bin/${workspaceFolderBasename}"
                            },
                            "serverHost": {
                                "type": "string",
                                "description": "DAP server IP",
                                "default": "127.0.0.1"
                            },
                            "serverPort": {
                                "type": "number",
                                "description": "DAP server localhost port",
                                "default": 4711
                            },
                            "stopAtEntry": {
                                "type": "boolean",
                                "default": true
                            }
                        }
                    }
                },
                "configurationSnippets": [
                    {
                        "label": "bcx: linux host",
                        "description": "local developer's host (project-local)",
                        "body": {
                            "type": "bcx",
                            "request": "launch",
                            "name": "bcx: linux host",
                            "program": "^\"\\${workspaceFolder}/bin/\\${workspaceFolderBasename}\"",
                            "serverHost": "127.0.0.1",
                            "serverPort": 4711
                        }
                    }
                ]
            }
        ],
        "commands": [
            {
                "command": "bcx.hello",
                "title": "bcx: hello",
                "icon": "$(gear)"
            },
            {
                "command": "bcx.run",
                "title": "bcx: run current bytecode on host VM",
                "icon": "$(play)"
            },
            {
                "command": "bcx.flash",
                "title": "bcx: flash firmware to connected MCU-based device",
                "icon": "$(chip)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "bcx",
                    "title": "bcx",
                    "icon": "$(chip)"
                }
            ]
        },
        "views": {
            "debug": [
                {
                    "id": "Ds",
                    "name": "Data Stack",
                    "when": "debugType == 'bcx'"
                },
                {
                    "id": "Rs",
                    "name": "Return Stack",
                    "when": "debugType == 'bcx'"
                }
            ],
            "bcx": [
                {
                    "id": "bcx.explorer",
                    "name": "bcx",
                    "icon": "$(circuit-board)",
                    "contextualTitle": "contextualTitle",
                    "type": "webview"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "bcx.hello",
                    "when": "view == bcx.explorer",
                    "group": "navigation@1"
                },
                {
                    "command": "bcx.run",
                    "when": "view == bcx.explorer",
                    "group": "navigation@2"
                },
                {
                    "command": "bcx.flash",
                    "when": "view == bcx.explorer",
                    "group": "navigation@3"
                }
            ]
        },
        "taskDefinitions": [
            {
                "type": "bcx",
                "required": [
                    "action"
                ],
                "properties": {
                    "action": {
                        "type": "string",
                        "enum": [
                            "run",
                            "flash",
                            "clean"
                        ]
                    }
                }
            }
        ]
    },
    "scripts": {
        "package": "vsce package"
    },
    "devDependencies": {
        "@vscode/vsce": "^2.24.0"
    }
}
