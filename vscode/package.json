{
    "name"        : "bcx",
    "displayName" : "bcx: ByteCode eXecutor",
    "description" : "script language VM for embedded systems",
    "version"     : "0.0.1",
    "icon"        : "./logo.png",
    "publisher"   : "dponyatov",
    "license"     : "MIT",
    "homepage"    : "https://github.com/ponyatov/bcx",
    "author": {
        "name": "Dmitry Ponyatov", "email": "dponyatov@gmail.com"
    },
    "bugs": {
        "url": "https://github.com/ponyatov/bcx/issue"
    },
    "repository": {
        "type": "git", "url" : "https://github.com/ponyatov/bcx/tree/dponyatov/vscode"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages", "Debuggers"
    ],
    "keywords": [
        "bcx", "bytecode", "VM",
        "FORTH","CLI", "REPL",
        "embedded", "MCU", "STM32", "ESP32"
    ],
    "activationEvents": [
        "onLanguage:bcx",
        "onDebugResolve:bcx",
        "onDebugDynamicConfigurations:bcx",
        "workspaceContains:lib/*.ini",
        "workspaceContains:lib/*.?"
    ],
    "extensionDependencies": [
        "ms-vscode.cpptools",
        "jeff-hykin.better-cpp-syntax",
        "ms-vscode.cmake-tools",
        "daohong-emilio.yash",
        "rreverser.ragel",
        "zixuanwang.linkerscript",
        "ms-vscode.vscode-serial-monitor"
    ],
    "main": "./extension.js",
    "contributes": {
        "languages": [
            {
                "id": "bcx",
                "aliases": [
                    "bcx",
                    "ByteCode eXecutor"
                ],
                "extensions": [
                    ".bcx",
                    ".ini",
                    ".f"
                ],
                "configuration": "./languageConfiguration.json"
            }
        ],
        "grammars": [
            {
                "language": "bcx",
                "scopeName": "source.bcx",
                "path": "./tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "bcx",
                "path": "./snippets.json"
            }
        ],
        "debuggers": [
            {
                "type": "bcx",
                "label": "bcx bytecode debugger",
                "languages": [
                    "bcx"
                ],
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Path to the bytecode image (bcx.bin) to execute"
                            },
                            "target": {
                                "type": "string",
                                "enum": [
                                    "linux",
                                    "win32",
                                    "rpi",
                                    "stm32f",
                                    "esp32s",
                                    "esp32c",
                                    "avr"
                                ],
                                "default": "linux",
                                "description": "Execution target (host VM or MCU under gdb/openocd)"
                            },
                            "gdb": {
                                "type": "string",
                                "default": "gdb-multiarch",
                                "description": "GDB executable used for MCU targets"
                            },
                            "openocd": {
                                "type": "string",
                                "default": "openocd",
                                "description": "OpenOCD executable used for MCU targets"
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "default": true
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "bcx",
                        "request": "launch",
                        "name": "bcx: launch (linux)",
                        "program": "${workspaceFolder}/bin/bcx",
                        "target": "linux",
                        "stopOnEntry": true
                    },
                    {
                        "type": "bcx",
                        "request": "launch",
                        "name": "bcx: launch (win32)",
                        "program": "${workspaceFolder}/bin/bcx,exe",
                        "target": "win32",
                        "stopOnEntry": true
                    },
                    {
                        "type": "bcx",
                        "request": "launch",
                        "name": "bcx: launch (stm32f)",
                        "program": "${workspaceFolder}/bin/bcx.elf",
                        "target": "stm32f",
                        "stopOnEntry": true
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "bcx: launch (linux)",
                        "body": {
                            "type": "bcx",
                            "request": "launch",
                            "name": "bcx: launch (linux)",
                            "program": "^\"\\${workspaceFolder}/bin/${workspaceFolderBaseName}\"",
                            "target": "linux"
                        }
                    }
                ]
            }
        ],
        "commands": [
            {
                "command": "bcx.compile",
                "title": "bcx: compile current file to bytecode"
            },
            {
                "command": "bcx.run",
                "title": "bcx: run current bytecode on host VM"
            },
            {
                "command": "bcx.flash",
                "title": "bcx: flash firmware to target MCU"
            }
        ],
        "taskDefinitions": [
            {
                "type": "bcx",
                "required": [
                    "action"
                ],
                "properties": {
                    "action": {
                        "type": "string",
                        "enum": [
                            "compile",
                            "flash",
                            "clean"
                        ]
                    }
                }
            }
        ]
    },
    "scripts": {
        "package": "vsce package"
    },
    "devDependencies": {
        "@vscode/vsce": "^2.24.0"
    }
}
