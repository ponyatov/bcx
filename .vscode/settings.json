{
    "multiCommand.commands": [
        { "command": "multiCommand.f11",
            "sequence": [ "workbench.action.files.saveAll",
                { "command": "workbench.action.terminal.sendSequence",
                    "args": {"text": "\u000D clear ; LANG=C make format doxy \u000D"}}]},
        { "command": "multiCommand.f12",
            "sequence": [ "workbench.action.files.saveAll",
                { "command": "workbench.action.terminal.sendSequence",
                    "args": {"text": "\u000D clear ; LANG=C make cross0 \u000D"}}]}
    ],

    // files
    "files.exclude": {
        "docs/**": true,
        ".vscode/*.log": true,
    },
    "files.watcherExclude": {
        "docs/**":  true,
        "tmp/**":   true,
        "ref/**":   true,
        "cross/**": true,
    },
    "files.associations": {
        "*.json":  "jsonc",
        "*.linux": "shellscript",
        "*.libc":  "shellscript",
        "*.bb":    "shellscript",
        "Makefile*": "makefile",
    },

    // editor
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.rulers": [80],
    "workbench.tree.indent": 24,
    "explorer.autoReveal": false,
    "files.insertFinalNewline": true,
    // "git.enabled": false,

    // clang-format
    "clang-format.executable":    "clang-format",
    "clang-format.fallbackStyle": "Google",
    "clang-format.style":         "file",

    // C++
    "[c,cpp]": {
        "editor.defaultFormatter": "xaver.clang-format",
        "editor.formatOnSave":     true
    },
    "C_Cpp.intelliSenseEngine": "Tag Parser",

    // cmake
    "cmake.buildDirectory":  "${workspaceFolder}/tmp/${workspaceFolderBasename}",
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.configureArgs": [ "-DAPP=${workspaceFolderBasename}" ],
    "cmake.debugConfig": {
         "cwd": "${workspaceFolder}",
        "args": ["${workspaceFolder}/lib/${workspaceFolderBasename}.ini"]
    },
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "cmake.generator": "Unix Makefiles",
}
