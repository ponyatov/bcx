# general
CONFIG_PREEMPT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n

# realtime
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y

# processor
CONFIG_SMP=y

# virt
CONFIG_HYPERVISOR_GUEST=y
CONFIG_VIRTUALIZATION=n

# power
# bus

# modules
CONFIG_MODULES=y
CONFIG_MODULE_COMPRESS_GZIP=y

# block
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_MAC_PARTITION=y

# binfmt
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# memory
CONFIG_SWAP=n

# net
CONFIG_NET=y
CONFIG_PACKET=m
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_INET_DIAG=m
CONFIG_IPV6=n
CONFIG_ETHTOOL_NETLINK=y

# wireless
CONFIG_WIRELESS=n

# file systems
CONFIG_EXT2_FS=m
CONFIG_EXT3_FS=m
CONFIG_EXT4_FS=m
CONFIG_DNOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_MSDOS_FS=m
CONFIG_VFAT_FS=m
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_EXFAT_FS=m
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NTFS3_FS=m
CONFIG_PROC_FS=y
CONFIG_TMPFS=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_HFS_FS=m
CONFIG_HFSPLUS_FS=m
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_4K_DEVBLK_SIZE=y

# netboot
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=y
CONFIG_IP_PNP_RARP=y
CONFIG_NETWORK_FILESYSTEMS=n
CONFIG_NFS_FS=m
CONFIG_NFS_V2=m
CONFIG_NFS_V3=m
CONFIG_NFS_V4=n
CONFIG_NFS_FSCACHE=y
CONFIG_NFS_DISABLE_UDP_SUPPORT=y
CONFIG_RPCSEC_GSS_KRB5=n
CONFIG_CIFS=n
CONFIG_CIFS_ALLOW_INSECURE_LEGACY=y
CONFIG_CIFS_DEBUG=y
CONFIG_CIFS_FSCACHE=y
CONFIG_SMB_SERVER=m
CONFIG_CODA_FS=n

# nls
CONFIG_NLS=m
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_CODEPAGE_866=m
CONFIG_NLS_CODEPAGE_1251=m
CONFIG_NLS_ASCII=m
CONFIG_NLS_ISO8859_1=m
CONFIG_NLS_ISO8859_5=m
CONFIG_NLS_KOI8_R=m
CONFIG_NLS_MAC_ROMAN=m
CONFIG_NLS_MAC_CYRILLIC=m
CONFIG_NLS_UTF8=m

# hacking
CONFIG_PRINTK_TIME=y
CONFIG_SYMBOLIC_ERRNAME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_SERIAL=y
CONFIG_X86_VERBOSE_BOOTUP=y

# drivers
CONFIG_PCI=y
CONFIG_PCCARD=m
CONFIG_PCMCIA=m
CONFIG_CARDBUS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PNP=y
CONFIG_PNPBIOS=y

# video
# framebuffer
CONFIG_SYSFB_SIMPLEFB=y

# disks
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_FD=m
CONFIG_BLK_DEV_LOOP=m
CONFIG_BLK_DEV_NVME=m

# scsi
CONFIG_SCSI=m
CONFIG_BLK_DEV_SD=m
CONFIG_BLK_DEV_SR=m
SCSI_LOWLEVEL=n
CONFIG_MEGARAID_LEGACY=m

# ATA
CONFIG_ATA=m
CONFIG_SATA_AHCI=m
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=m
CONFIG_PATA_SCH=m
CONFIG_ATA_GENERIC=m
CONFIG_PATA_LEGACY=m

# network
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=n
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_3COM=n
