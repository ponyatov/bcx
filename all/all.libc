ARCH_USE_MMU=y
# UCLIBC_HAS_FLOATS=y

HAVE_SHARED=y
LDSO_CACHE_SUPPORT=n
LDSO_PRELOAD_ENV_SUPPORT=n

# UCLIBC_CTOR_DTOR=n

UCLIBC_HAS_THREADS_NATIVE=y
MALLOC_STANDARD=y

# UCLIBC_STRICT_HEADERS=y
# UCLIBC_HAS_STUBS=y

UCLIBC_HAS_NETWORK_SUPPORT=y
UCLIBC_HAS_IPV4=y
UCLIBC_HAS_IPV6=n
UCLIBC_USE_NETLINK=y

# WARNINGS="-Wno-implicit-function-declaration -Wno-int-conversion"
UCLIBC_LINUX_SPECIFIC=y
UCLIBC_HAS_REALTIME=y
UCLIBC_HAS_GNU_GETOPT=y

RUNTIME_PREFIX=""
DEVEL_PREFIX="/usr/"
